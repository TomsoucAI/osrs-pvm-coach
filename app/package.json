{
  "name": "osrs-dps-mcp-server",
  "version": "0.2.0",
  "description": "MCP server: live OSRS DPS from RuneLite using the OSRS Wiki DPS calculator engine",
  "main": "index.js",
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node dist/selftest.js && node --test dist/core.test.js dist/ui.test.js && tsx scripts/smoke.ts",
    "start": "node dist/index.js",
    "ui": "node dist/ui.js",
    "setup": "node setup.mjs",
    "update-calc": "node setup.mjs --latest && tsx scripts/gen-engine-named-items.ts && node build.mjs",
    "gen-named-items": "tsx scripts/gen-engine-named-items.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "axios": "^1.21.1",
    "d3-array": "^3.2.5",
    "delay": "^7.0.0",
    "lodash.mergewith": "^4.6.2",
    "mobx": "^7.1.7",
    "react": "^19.3.1",
    "type-fest": "^5.10.0",
    "uuid": "^14.0.3",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/lodash.mergewith": "^4.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "type": "module",
  "bin": {
    "osrs-dps-mcp-server": "dist/index.js"
  },
  "engines": {
    "node": ">=20.3"
  }
}
