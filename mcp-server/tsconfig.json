{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "paths": { "@/*": ["./../vendor/osrs-dps-calc/src/*"] },
    "types": ["node"]
  },
  "include": ["src/**/*", "scripts/**/*"]
}
